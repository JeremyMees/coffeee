{
  "name": "coffeee",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "typecheck": "nuxt typecheck",
    "prepare": "husky",
    "deps": "npx taze -w",
    "test:e2e": "nuxt build && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "import:notion:dev": "nuxi task run notion:import",
    "import:notion:prod": "nuxi task run notion:import --payload.target=production"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.10",
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.63.0",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/hints": "1.1.5",
    "@nuxt/image": "^2.2.1",
    "@nuxt/test-utils": "4.3.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-query": "^5.105.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.4",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "^15.0.0",
    "better-auth": "1.7.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.13.0",
    "h3": "1.15.11",
    "nitropack": "2.13.5",
    "nuxt": "4.6.3",
    "pg": "^8.23.1",
    "reka-ui": "^2.11.0",
    "shadcn-nuxt": "^2.9.0",
    "tailwindcss": "^4.3.3",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@golar/vue": "^0.1.11",
    "@playwright/test": "^1.64.1",
    "@tanstack/eslint-plugin-query": "^5.105.1",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "drizzle-kit": "^0.31.11",
    "golar": "^0.1.11",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
